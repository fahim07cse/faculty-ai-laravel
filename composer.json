{
  "name": "faculty-ai/faculty-ai-explorer",
  "type": "project",
  "description": "Faculty AI Explorer Laravel application.",
  "keywords": [
    "laravel",
    "faculty",
    "ai",
    "research"
  ],
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
